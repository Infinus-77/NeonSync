rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helpers ───────────────────────────────────────────────────────────────

    function isAuthenticated() {
      return request.auth != null;
    }

    function currentUid() {
      return request.auth.uid;
    }

    // Safely fetch the caller's role. Returns '' if the doc doesn't exist,
    // preventing the entire rule from erroring out and silently denying access.
    function getRole() {
      let userData = get(/databases/$(database)/documents/users/$(request.auth.uid));
      return userData.data.get('role', '');
    }

    function isSuperAdmin() {
      return isAuthenticated() && getRole() in ['super_admin', 'Super Admin', 'SUPER_ADMIN'];
    }

    // isAdmin() is true for both 'super_admin' and 'admin' roles.
    function isAdmin() {
      return isAuthenticated() && getRole() in ['super_admin', 'admin', 'Admin', 'Super Admin', 'SUPER_ADMIN', 'ADMIN'];
    }

    function isOwner(userId) {
      return isAuthenticated() && currentUid() == userId;
    }

    function getUserCompanyId() {
      let userData = get(/databases/$(database)/documents/users/$(request.auth.uid));
      return userData.data.get('companyId', '');
    }

    function isSameCompany(docCompanyId) {
      // Allow if user is in the same company, OR if doc is legacy (no companyId yet)
      return isAuthenticated() && (getUserCompanyId() == docCompanyId || docCompanyId == '');
    }

    // ─── Companies ─────────────────────────────────────────────────────────────
    match /companies/{companyId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isSameCompany(companyId) && isSuperAdmin();
    }

    // ─── Users ─────────────────────────────────────────────────────────────────
    match /users/{userId} {
      // Users can read their own profile, or other users in their company.
      allow read: if isOwner(userId) || (isAuthenticated() && isSameCompany(resource.data.get('companyId', '')));
      // Anyone can create their user profile (during registration).
      allow create: if isAuthenticated();
      allow update: if isOwner(userId) || (isSameCompany(resource.data.get('companyId', '')) && isAdmin() && (
        request.resource.data.get('role', '') == resource.data.get('role', '') || 
        resource.data.get('role', '') != 'super_admin'
      ));
      allow delete: if isSameCompany(resource.data.get('companyId', '')) && isSuperAdmin() && (isOwner(userId) || resource.data.get('role', '') != 'super_admin');
    }

    // ─── Tasks ─────────────────────────────────────────────────────────────────
    match /tasks/{taskId} {
      allow read: if isSameCompany(resource.data.get('companyId', '')) && (
        isAdmin() || (isAuthenticated() && (
          resource.data.get('isCommonTask', false) == true
          || currentUid() in resource.data.get('assignedTo', [])
        ))
      );

      allow create: if isSameCompany(request.resource.data.get('companyId', '')) && isAdmin();

      allow update: if isSameCompany(resource.data.get('companyId', '')) && (
        isAdmin() || (isAuthenticated() && currentUid() in resource.data.get('assignedTo', []))
      );

      allow delete: if isSameCompany(resource.data.get('companyId', '')) && isSuperAdmin();
    }

    // ─── Chats ─────────────────────────────────────────────────────────────────
    match /chats/{chatId} {
      allow read: if isSameCompany(resource.data.get('companyId', '')) && (
        isSuperAdmin() || isAdmin() || (isAuthenticated() && (
          resource.data.get('type', '') in ['global', 'role'] || currentUid() in resource.data.get('members', [])
        ))
      );
      allow create: if isSameCompany(request.resource.data.get('companyId', '')) && isAdmin();
      allow update: if isSameCompany(resource.data.get('companyId', '')) && isAdmin();
      allow delete: if isSameCompany(resource.data.get('companyId', '')) && isSuperAdmin();
    }

    // ─── Messages ──────────────────────────────────────────────────────────────
    match /messages/{messageId} {
      allow read: if isSameCompany(resource.data.get('companyId', ''));
      allow create: if isSameCompany(request.resource.data.get('companyId', '')) && request.resource.data.senderId == currentUid();
      allow update, delete: if isSameCompany(resource.data.get('companyId', '')) && isSuperAdmin();
    }

    // ─── Notifications ─────────────────────────────────────────────────────────
    match /notifications/{notifId} {
      allow read: if isSameCompany(resource.data.get('companyId', '')) && resource.data.userId == currentUid();
      allow create: if isSameCompany(request.resource.data.get('companyId', '')) && isAdmin();
      allow update: if isSameCompany(resource.data.get('companyId', '')) && resource.data.userId == currentUid() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']);
      allow delete: if isSameCompany(resource.data.get('companyId', '')) && (isSuperAdmin() || resource.data.userId == currentUid());
    }

    // ─── Task Logs (audit trail) ───────────────────────────────────────────────
    match /taskLogs/{logId} {
      allow read: if isSameCompany(resource.data.get('companyId', ''));
      allow create: if isSameCompany(request.resource.data.get('companyId', ''));
      allow update, delete: if isSameCompany(resource.data.get('companyId', '')) && isSuperAdmin();
    }

    // ─── Activity Logs (heatmap) ───────────────────────────────────────────────
    match /activityLogs/{logId} {
      allow read: if isSameCompany(resource.data.get('companyId', ''));
      allow create: if isSameCompany(request.resource.data.get('companyId', '')) && request.resource.data.userId == currentUid();
      allow update, delete: if isSameCompany(resource.data.get('companyId', '')) && isSuperAdmin();
    }

    // ─── Typing indicators ─────────────────────────────────────────────────────
    match /typing/{chatId} {
      allow read, write: if isAuthenticated();
    }

    // ─── Last-seen (cross-device unread tracking) ──────────────────────────────
    match /lastSeen/{userId} {
      allow read, write: if isAuthenticated() && currentUid() == userId;
    }

    // ─── Calendar Events ────────────────────────────────────────────────────────
    match /events/{eventId} {
      allow read: if isSameCompany(resource.data.get('companyId', '')) && (
        resource.data.get('createdBy', '') == currentUid()
        || resource.data.get('visibility', 'private') == 'all'
        || (resource.data.get('visibility', 'private') == 'admin' && isAdmin())
      );
      allow create: if isSameCompany(request.resource.data.get('companyId', '')) && request.resource.data.get('createdBy', '') == currentUid();
      allow update: if isSameCompany(resource.data.get('companyId', '')) && (resource.data.get('createdBy', '') == currentUid() || isAdmin());
      allow delete: if isSameCompany(resource.data.get('companyId', '')) && (resource.data.get('createdBy', '') == currentUid() || isAdmin());
    }

    // ─── Idea Library ──────────────────────────────────────────────────────────
    match /ideas/{ideaId} {
      allow read, write: if isSameCompany(resource.data.get('companyId', '')) && isAdmin();
      allow create: if isSameCompany(request.resource.data.get('companyId', '')) && isAdmin();
    }

    // ─── Default deny ──────────────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
